[Unit]
Description=Okozukai Bot (Pi 4 Socket Mode + hardware)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jhonda
WorkingDirectory=/home/jhonda/app/pi
EnvironmentFile=/home/jhonda/app/pi/.env
ExecStart=/home/jhonda/app/pi/.venv/bin/python /home/jhonda/app/pi/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
