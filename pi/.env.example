# cp .env.example .env してから値を入れる。.env は .gitignore 済み。

# 仕様書 §4-1: Settings > Socket Mode > App-Level Token (connections:write)
SLACK_APP_TOKEN=xapp-...

# 仕様書 §4-2: OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# true にすると Slack に投稿せず即時承認する(仕様書 §1: 配線・DB確認用プロトタイプモード)
OKOZUKAI_AUTO_APPROVE=false

# "gpio"(実機) | "dummy"(この開発機など、GPIO/I2C が無い環境での動作確認用)
OKOZUKAI_HARDWARE=gpio

# 配線に合わせて変更する
OKOZUKAI_BUTTON_PIN_A=17
OKOZUKAI_BUTTON_PIN_B=27
OKOZUKAI_BUZZER_PIN=22
OKOZUKAI_LCD_I2C_ADDRESS=0x27

# 省略時は pi/data/okozukai.db
# OKOZUKAI_DB_PATH=/home/pi/app/pi/data/okozukai.db
