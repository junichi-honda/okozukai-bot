# cp .env.example .env してから値を入れる。.env は .gitignore 済み。

# Settings > Socket Mode > App-Level Token (connections:write)
SLACK_APP_TOKEN=xapp-...

# OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# 申請を投稿するプライベートチャンネルの ID(チャンネル詳細 > 一番下に表示される C から始まる文字列)
CHANNEL_ID=C0000000000

# 承認者(保護者)の Slack ユーザー ID をカンマ区切りで指定
# 各ユーザーのプロフィール > ... > "メンバーIDをコピーする" で取得できる
SLACK_APPROVERS=U0000000000,U0000000001

# true にすると Slack に投稿せず即時承認する(配線・DB確認用プロトタイプモード)
OKOZUKAI_AUTO_APPROVE=false

# "gpio"(実機) | "dummy"(Pi以外の環境での動作確認用)
OKOZUKAI_HARDWARE=gpio

# 配線に合わせて変更する
OKOZUKAI_BUTTON_PIN_A=17
OKOZUKAI_BUTTON_PIN_B=27
OKOZUKAI_BUZZER_PIN=22
OKOZUKAI_LCD_I2C_ADDRESS=0x27

# 省略時は pi/data/okozukai.db
# OKOZUKAI_DB_PATH=/home/pi/app/pi/data/okozukai.db
