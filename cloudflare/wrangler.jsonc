{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okozukai-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },

  // SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET / CHANNEL_ID / SLACK_APPROVERS は
  // すべて `wrangler secret put` で登録する(このリポジトリには値を含めない)。

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okozukai-bot",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE"
    }
  ],

  // Cloudflare の cron は UTC 固定。15:05 UTC = 翌日 00:05 JST に相当するため
  // 毎日この時刻に起動し、JST で1日かどうかを scheduled ハンドラ側で判定する。
  "triggers": {
    "crons": ["5 15 * * *"]
  }
}
